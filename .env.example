# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Shared passphrase for the whole group. Required in production: without it the site stays locked.
TRIP_PASSPHRASE=

# The chat assistant (Google AI Studio key). Without it the planner shows a notice and manual editing still works.
GEMINI_API_KEY=
# Optional: override the model id from src/lib/llm/config.ts.
# GEMINI_MODEL=gemini-3.8-flash

# Upstash Redis. Connecting Upstash from the Vercel Marketplace sets these automatically.
# (A direct Upstash database uses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead; either works.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only for a throwaway deploy with no Redis: keeps edits in memory, and they vanish on every cold start.
# ALLOW_MEMORY_STORE=1

# Gemini API Key for AI trip assistant / proposals
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Local UI testing only: a scripted fake model instead of Gemini. Ignored in production.
# CHAT_MOCK=1
