{
  "name": "trip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "summary": "tsx --conditions=react-server scripts/trip-summary.ts",
    "assistant:eval": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/assistant-eval.ts",
    "import:eval": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-eval.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.77",
    "@ai-sdk/react": "^4.0.114",
    "@serwist/turbopack": "^9.5.13",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.111",
    "chrono-node": "^2.10.2",
    "google-auth-library": "^11.3.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "zod": "4.6.7"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
